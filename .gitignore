# Maven
target/
*.class
*.jar
!src/**/**.jar
dependency-reduced-pom.xml
*.exec

# PGO profile from `make native-pgo-instrument` (regenerated; git add -f a curated one to commit)
default.iprof

# IDE
.idea/
*.iml
.vscode/
.nb-gradle/
*.swp
*~

# AI agent local state (Claude, Codex, etc.)
.claude/
.codex/
.agents/

# Native-image build output / GraalVM AWT extraction (dropped in the repo root when running the native binary)
/pijota-0.1.0-SNAPSHOT
/*.so

# OS
.DS_Store
Thumbs.db

# Python / misc
__pycache__/
*.pyc

# Scratch in the repo root (ad-hoc markdown-render fixtures, playground scripts) — keep the root clean.
# Real top-level docs are kept via the exceptions below; add more with !/NAME.md as needed.
/*.py
/*.md
!/README.md
!/AGENTS.md
!/CLAUDE.md

# Test artifacts at repo root (session exports, ad-hoc test output)
/*.jsonl
/*.json

# Log files
*.log
logs/

# Temporary / scratch files
*.tmp
*.temp

# Pijota local state (generated at runtime)
.pijota/
