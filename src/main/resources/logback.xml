<configuration>
    <!-- Silence Logback's own configuration status dump. In the native image the version metadata isn't embedded,
         so Logback emits a version-mismatch WARN, and on any WARN it prints its entire internal status history to
         the console, noise over Pijota's otherwise-clean startup screen. NopStatusListener swallows it.
         (Registered for reflection in native-image reachability-metadata.json.) -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Rolling file appender: the primary log sink for Pijota -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${pijota.logDir:-${user.home}/.pijota/logs}/pijota.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${pijota.logDir:-${user.home}/.pijota/logs}/pijota.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>3</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File is the sole sink: full diagnostics go here, while user-facing text is owned by CliErrorReporter /
         System.out. A stderr console appender would double-print (CliErrorReporter already writes to stderr) and
         dump stack traces over the otherwise-clean terminal. -->
    <!-- Default INFO; raise without a rebuild via env: PIJOTA_LOG_LEVEL=DEBUG (or TRACE) pijota …
         DEBUG adds tool arguments + LLM request lines; TRACE adds the per-token stream firehose. -->
    <root level="${PIJOTA_LOG_LEVEL:-INFO}">
        <appender-ref ref="FILE" />
    </root>
</configuration>
